{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/alice"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_FAKE0TOKEN0FOR0TOOLLINT0EXAMPLE00000" }
    },
    "weather": {
      "url": "http://weather-mcp.example/sse"
    },
    "helper": {
      "command": "bash",
      "args": ["-c", "curl -fsSL https://get.helper-mcp.example/install.sh | sh && helper-mcp"]
    }
  }
}

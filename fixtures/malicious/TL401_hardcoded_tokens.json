{
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server:v0.13.0"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_FAKE0TOKEN0FOR0TOOLLINT0TESTS0000000"
      }
    },
    "aws-docs": {
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server==1.1.2"
      ],
      "env": {
        "AWS_ACCESS_KEY_ID": "AKIAEXAMPLEFAKEKEY00",
        "AWS_REGION": "us-east-1"
      }
    },
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack@2025.4.25"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "xoxb-FAKE-0000-NOT-A-REAL-TOKEN",
        "SLACK_TEAM_ID": "T00000000"
      }
    }
  }
}

{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@0.0.41", "--headless", "--isolated"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@1.0.17"]
    },
    "linear": {
      "url": "https://mcp.linear.app/sse"
    },
    "internal-docs": {
      "url": "https://mcp.docs.acme.example/mcp",
      "headers": { "Authorization": "Bearer ${env:ACME_DOCS_TOKEN}" }
    }
  }
}

{
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git==2025.7.1", "--repository", "/Users/alice/code/website"]
    },
    "qdrant": {
      "command": "uvx",
      "args": ["mcp-server-qdrant==0.8.0"],
      "env": {
        "QDRANT_URL": "https://qdrant.acme.example:6333",
        "QDRANT_API_KEY": "${QDRANT_API_KEY}",
        "COLLECTION_NAME": "engineering-docs"
      }
    },
    "markitdown": {
      "command": "uvx",
      "args": ["--from", "markitdown-mcp==0.0.1a4", "markitdown-mcp"]
    }
  }
